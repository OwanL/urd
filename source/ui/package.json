{
  "name": "urd-ui",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "check": "oxfmt --check . && oxlint --type-aware --deny-warnings . && tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fast": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:integration": "node --test tests/SessionClient.integration.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
