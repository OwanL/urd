{
  "name": "urd-ui",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test:browser:host": "node tests/BrowserFixture.ts",
    "check": "oxfmt --check . && oxlint --type-aware --deny-warnings . && tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fast": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "node --test tests/BrowserRegression.ts",
    "test:display": "node --test tests/SemanticDisplay.browser.ts",
    "test:integration": "node --test tests/SessionClient.integration.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "preact": "11.2.0"
  }
}
