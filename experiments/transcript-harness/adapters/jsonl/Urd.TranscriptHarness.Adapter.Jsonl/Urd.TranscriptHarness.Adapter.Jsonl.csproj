<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Urd.TranscriptHarness.Adapter.JsonlStore</RootNamespace>
    <!-- The store host loads this assembly by explicit path (plugin loader with
         AssemblyDependencyResolver); dependencies and native assets must be
         copied and resolvable from this assembly's own bin directory. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Family 10 hybrid index: one small SQLite database per store root for
         coordination (pointers, offsets, preview rows, assignments, drafts).
         Pinned to the same version the SQLite-rows adapter uses. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\contracts\Urd.TranscriptHarness.Contracts\Urd.TranscriptHarness.Contracts.csproj" />
  </ItemGroup>

</Project>