<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <RootNamespace>Urd.TranscriptHarness.Adapter.SqliteExternal.Tests</RootNamespace>
    <!-- Consumes PRE-BUILT shared contracts and the pre-built adapter via
         HintPath so it never triggers a shared-project build
         (-p:BuildProjectReferences=false stays possible everywhere). -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Urd.TranscriptHarness.Contracts">
      <HintPath>..\..\..\..\contracts\Urd.TranscriptHarness.Contracts\bin\Release\net10.0\Urd.TranscriptHarness.Contracts.dll</HintPath>
    </Reference>
    <Reference Include="Urd.TranscriptHarness.Adapter.SqliteExternal">
      <HintPath>..\..\Urd.TranscriptHarness.Adapter.SqliteExternal\bin\Release\net10.0\Urd.TranscriptHarness.Adapter.SqliteExternal.dll</HintPath>
    </Reference>
    <!-- For payload-publication invariant peeks only: consume the SAME SQLite
         binding copy the adapter restores, so no extra package reference
         appears here. -->
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>..\..\Urd.TranscriptHarness.Adapter.SqliteExternal\bin\Release\net10.0\Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
    <!-- The copied adapter DLL needs its deps.json + native runtimes tree
         beside it so its AssemblyDependencyResolver wiring keeps working. -->
    <None Include="..\..\Urd.TranscriptHarness.Adapter.SqliteExternal\bin\Release\net10.0\Urd.TranscriptHarness.Adapter.SqliteExternal.deps.json"
          CopyToOutputDirectory="PreserveNewest" Link="Urd.TranscriptHarness.Adapter.SqliteExternal.deps.json" />
    <None Include="..\..\Urd.TranscriptHarness.Adapter.SqliteExternal\bin\Release\net10.0\runtimes\**\*.*"
          CopyToOutputDirectory="PreserveNewest" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>