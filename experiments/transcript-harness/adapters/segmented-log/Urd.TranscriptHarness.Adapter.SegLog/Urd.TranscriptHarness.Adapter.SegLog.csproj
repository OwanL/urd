<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Urd.TranscriptHarness.Adapter.SegLog</RootNamespace>
    <!-- The store host loads this assembly by explicit path (plugin loader with
         AssemblyDependencyResolver); dependencies and native assets must be
         copied and resolvable from this assembly's own bin directory. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Family 6 segmented binary log: append-only per-session segments plus
         an explicit SQLite index (the authority for sessions, ordinals,
         segment/offset pointers, preview metadata, and assignments). Pinned
         to the same version the other SQLite-index families use. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\contracts\Urd.TranscriptHarness.Contracts\Urd.TranscriptHarness.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests select a small segment target via the internal constructor. -->
    <InternalsVisibleTo Include="Urd.TranscriptHarness.SegLog.Tests" />
  </ItemGroup>

</Project>