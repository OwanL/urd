<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Urd.Core</AssemblyName>
    <RootNamespace>Urd.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="[1.10.4]" />
    <PackageReference Include="Microsoft.Playwright" Version="[1.65.0]" />
    <PackageReference Include="ModelContextProtocol.Core" Version="[2.3.1]" />
    <PackageReference Include="PdfPig" Version="[0.1.16]" />
    <PackageReference Include="Markdig" Version="[1.6.0]" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="3.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
    <PackageReference Include="Duende.IdentityModel" Version="8.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <InternalsVisibleTo Include="Urd.Backend.Tests" />
    <InternalsVisibleTo Include="Urd.Server" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="harness/usage/model-price-seed.json" LogicalName="Urd.ModelPriceSeed.json" />
    <None Update="harness/usage/models-dev-LICENSE.txt" Link="licenses/models-dev-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Packaged skills are files the model reads, so they are copied beside the server. -->
    <None Remove="harness/context/skills/**" />
    <None Include="harness/context/skills/**" Link="skills/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../vendor/fd/fd.targets" />
</Project>
